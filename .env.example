# --- deployment (NEVER commit the real .env) ---
# Private key of the deployer wallet (BSC testnet). Fund it from a faucet.
PRIVATE_KEY=0x...

# Optional overrides
FEE_RECIPIENT=0x...
PANCAKE_ROUTER=0xD99D1c33F9fC3444f8101754aBC46c52416550D1

# RPC endpoints
BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com
BSC_RPC=https://bsc-dataseed.bnbchain.org

# BscScan API key for contract verification
BSCSCAN_API_KEY=

# --- oracle service (filled in later) ---
ORACLE_ADDRESS=
UPDATER_PRIVATE_KEY=0x...

# --- MAINNET one-shot launch (script/GoLive.s.sol) ---
# Your token identity:
TOKEN_NAME=AnyPair Meme
TOKEN_SYMBOL=ANYP
# The real asset this token is paired to + its human label:
ASSET_KEY=cs2:awp-asiimov-ft
ASSET_DESC=CS2 | AWP Asiimov (FT)
# 0=REAL, 1=INDEX, 2=LARP
FEED_TIER=0
# Asset price in USD, 1e18 fixed point (143 -> 143000000000000000000)
ASSET_PRICE_USD=143000000000000000000
# Curve tuning (wei). Low threshold = cheap launch. 0.02 BNB default.
GRAD_THRESHOLD=20000000000000000
VIRTUAL_BNB=50000000000000000
